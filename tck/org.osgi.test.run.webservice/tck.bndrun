# No java: — the test VM is the same as the build's. A fixed path would
# only be valid on one machine; the minimum version a run requires is
# recorded as jdk.run.minimum in the POM.
-tester: biz.aQute.tester.junit-platform

-runee: JavaSE-17

-resolve.effective: active

-runvm: ${def;argLine}, -Djava.security.manager=allow

-runproperties: \
	org.apache.felix.http.host=127.0.0.1,\
	org.osgi.service.http.port=8080,\
	org.apache.felix.http.whiteboard.changecount.delay=0

-runfw: org.eclipse.osgi


# API overlays on the framework classpath (exports become system packages)
-runpath: \


# This will help us keep -runbundles sorted
-runstartlevel: \
    order=sortbynameversion,\
    begin=-1

-runrequires: \
	bnd.identity;id='org.osgi.test.cases.webservice',\
	bnd.identity;id='org.eclipse.osgi-technology.webservices.org.eclipse.osgi.technology.webservices.runtime.registrar',\
	bnd.identity;id='jakarta.activation-api',\
	bnd.identity;id='jakarta.annotation-api',\
	bnd.identity;id='jakarta.xml.bind-api',\
	bnd.identity;id='jakarta.xml.soap-api',\
	bnd.identity;id='jakarta.xml.ws-api',\
	bnd.identity;id='org.glassfish.external.management-api',\
	bnd.identity;id='org.glassfish.ha.ha-api',\
	bnd.identity;id='org.glassfish.gmbal.gmbal-api-only',\
	bnd.identity;id='org.glassfish.hk2.osgi-resource-locator',\
	bnd.identity;id='org.apache.felix.scr',\
	bnd.identity;id='com.fasterxml.woodstox.woodstox-core',\
	bnd.identity;id='stax2-api',\
	bnd.identity;id='com.sun.xml.bind.jaxb-core',\
	bnd.identity;id='com.sun.xml.bind.jaxb-impl',\
	bnd.identity;id='com.sun.xml.stream.buffer.streambuffer',\
	bnd.identity;id='org.jvnet.mimepull',\
	bnd.identity;id='org.jvnet.staxex.stax-ex',\
	bnd.identity;id='com.sun.xml.fastinfoset.FastInfoset',\
	bnd.identity;id='com.sun.xml.ws.jaxws-rt',\
	bnd.identity;id='assertj-core';version='[3.23.1,3.23.2)',\
	bnd.identity;id='junit-jupiter-api';version='[5.8.2,5.8.3)',\
	bnd.identity;id='junit-jupiter-engine';version='[5.8.2,5.8.3)',\
	bnd.identity;id='junit-jupiter-params';version='[5.8.2,5.8.3)',\
	bnd.identity;id='junit-platform-commons';version='[1.8.2,1.8.3)',\
	bnd.identity;id='junit-platform-engine';version='[1.8.2,1.8.3)',\
	bnd.identity;id='junit-platform-launcher';version='[1.8.2,1.8.3)',\
	bnd.identity;id='junit-vintage-engine';version='[5.8.2,5.8.3)',\
	bnd.identity;id='org.hamcrest';version='[2.2.0,2.2.1)',\
	bnd.identity;id='org.awaitility';version='[4.2.0,4.2.1)',\
	bnd.identity;id='org.apache.servicemix.bundles.junit';version='[4.13.2.1,4.13.2.2)',\
	bnd.identity;id='org.opentest4j';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.common';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.assertj.framework';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.junit5';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.junit4';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.mockito.mockito-core';version='[4.6.1,4.6.2)',\
	bnd.identity;id='net.bytebuddy.byte-buddy';version='[1.12.10,1.12.11)',\
	bnd.identity;id='net.bytebuddy.byte-buddy-agent';version='[1.12.10,1.12.11)',\
	bnd.identity;id='org.objenesis'

# Test infrastructure for the junit-platform tester — mirrors the original
# cnf/repo/osgi.tck.junit-platform lib that every TCK run carried
-runbundles.tck: \
	assertj-core;version='[3.23.1,3.23.2)',\
	junit-jupiter-api;version='[5.8.2,5.8.3)',\
	junit-jupiter-engine;version='[5.8.2,5.8.3)',\
	junit-jupiter-params;version='[5.8.2,5.8.3)',\
	junit-platform-commons;version='[1.8.2,1.8.3)',\
	junit-platform-engine;version='[1.8.2,1.8.3)',\
	junit-platform-launcher;version='[1.8.2,1.8.3)',\
	junit-vintage-engine;version='[5.8.2,5.8.3)',\
	org.hamcrest;version='[2.2.0,2.2.1)',\
	org.awaitility;version='[4.2.0,4.2.1)',\
	org.apache.servicemix.bundles.junit;version='[4.13.2.1,4.13.2.2)',\
	org.opentest4j;version='[1.2.0,1.2.1)',\
	org.osgi.test.common;version='[1.2.0,1.2.1)',\
	org.osgi.test.assertj.framework;version='[1.2.0,1.2.1)',\
	org.osgi.test.junit5;version='[1.2.0,1.2.1)',\
	org.osgi.test.junit4;version='[1.2.0,1.2.1)',\
	org.mockito.mockito-core;version='[4.6.1,4.6.2)',\
	net.bytebuddy.byte-buddy;version='[1.12.10,1.12.11)',\
	net.bytebuddy.byte-buddy-agent;version='[1.12.10,1.12.11)',\
	org.objenesis


# -runbundles is calculated by the bnd-resolver-maven-plugin during the run
-runbundles:
