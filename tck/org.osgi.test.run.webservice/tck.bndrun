# No java: — the test VM is the same as the build's. A fixed path would
# only be valid on one machine; the minimum version a run requires is
# recorded as jdk.run.minimum in the POM.
-tester: biz.aQute.tester.junit-platform

-runee: JavaSE-17

-resolve.effective: active

-runvm: ${def;argLine}, -Djava.security.manager=allow

-runproperties: \
	org.apache.felix.http.host=127.0.0.1,\
	org.osgi.service.http.port=8080,\
	org.apache.felix.http.whiteboard.changecount.delay=0

-runfw: org.eclipse.osgi


# API overlays on the framework classpath (exports become system packages)
-runpath: \


# This will help us keep -runbundles sorted
-runstartlevel: \
    order=sortbynameversion,\
    begin=-1

# Test runtime versions: the Maven properties of tck/pom.xml, as the OSGi
# range [x.y.z,x.y.z+1). version_cleanup turns 1.4.0-SNAPSHOT into 1.4.0.SNAPSHOT.
tck.range: ${range;[===,==+);${version_cleanup;${1}}}

-runrequires: \
	bnd.identity;id='org.osgi.test.cases.webservice';version='${tck.range;${revision}}',\
	bnd.identity;id='org.eclipse.osgi-technology.webservices.org.eclipse.osgi.technology.webservices.runtime.registrar';version='${tck.range;${org.eclipse.osgi.technology.webservices.runtime.registrar.version}}',\
	bnd.identity;id='jakarta.activation-api';version='${tck.range;${jakarta.activation-api.version}}',\
	bnd.identity;id='jakarta.annotation-api';version='${tck.range;${jakarta.annotation-api.version}}',\
	bnd.identity;id='jakarta.xml.bind-api';version='${tck.range;${jakarta.xml.bind-api.version}}',\
	bnd.identity;id='jakarta.xml.soap-api';version='${tck.range;${jakarta.xml.soap-api.version}}',\
	bnd.identity;id='jakarta.xml.ws-api';version='${tck.range;${jakarta.xml.ws-api.version}}',\
	bnd.identity;id='org.glassfish.external.management-api';version='${tck.range;${management-api.version}}',\
	bnd.identity;id='org.glassfish.ha.ha-api';version='${tck.range;${ha-api.version}}',\
	bnd.identity;id='org.glassfish.gmbal.gmbal-api-only';version='${tck.range;${gmbal-api-only.version}}',\
	bnd.identity;id='org.glassfish.hk2.osgi-resource-locator';version='${tck.range;${osgi-resource-locator.version}}',\
	bnd.identity;id='org.apache.felix.scr';version='${tck.range;${org.apache.felix.scr.version}}',\
	bnd.identity;id='com.fasterxml.woodstox.woodstox-core';version='${tck.range;${woodstox-core.version}}',\
	bnd.identity;id='stax2-api';version='${tck.range;${stax2-api.version}}',\
	bnd.identity;id='com.sun.xml.bind.jaxb-core';version='${tck.range;${jaxb-core.version}}',\
	bnd.identity;id='com.sun.xml.bind.jaxb-impl';version='${tck.range;${jaxb-impl.version}}',\
	bnd.identity;id='com.sun.xml.stream.buffer.streambuffer';version='${tck.range;${streambuffer.version}}',\
	bnd.identity;id='org.jvnet.mimepull';version='${tck.range;${mimepull.version}}',\
	bnd.identity;id='org.jvnet.staxex.stax-ex';version='${tck.range;${stax-ex.version}}',\
	bnd.identity;id='com.sun.xml.fastinfoset.FastInfoset';version='${tck.range;${FastInfoset.version}}',\
	bnd.identity;id='com.sun.xml.ws.jaxws-rt';version='${tck.range;${jaxws-rt.version}}',\
	bnd.identity;id='assertj-core';version='${tck.range;${assertj.version}}',\
	bnd.identity;id='junit-jupiter-api';version='${tck.range;${junit-jupiter.version}}',\
	bnd.identity;id='junit-jupiter-engine';version='${tck.range;${junit-jupiter.version}}',\
	bnd.identity;id='junit-jupiter-params';version='${tck.range;${junit-jupiter.version}}',\
	bnd.identity;id='junit-platform-commons';version='${tck.range;${junit-platform.version}}',\
	bnd.identity;id='junit-platform-engine';version='${tck.range;${junit-platform.version}}',\
	bnd.identity;id='junit-platform-launcher';version='${tck.range;${junit-platform.version}}',\
	bnd.identity;id='junit-vintage-engine';version='${tck.range;${junit-jupiter.version}}',\
	bnd.identity;id='org.hamcrest';version='${tck.range;${hamcrest.version}}',\
	bnd.identity;id='org.awaitility';version='${tck.range;${awaitility.version}}',\
	bnd.identity;id='org.apache.servicemix.bundles.junit';version='[4.13.2.1,4.13.2.2)',\
	bnd.identity;id='org.opentest4j';version='${tck.range;${opentest4j.version}}',\
	bnd.identity;id='org.osgi.test.common';version='${tck.range;${osgi-test.version}}',\
	bnd.identity;id='org.osgi.test.assertj.framework';version='${tck.range;${osgi-test.version}}',\
	bnd.identity;id='org.osgi.test.junit5';version='${tck.range;${osgi-test.version}}',\
	bnd.identity;id='org.osgi.test.junit4';version='${tck.range;${osgi-test.version}}',\
	bnd.identity;id='org.mockito.mockito-core';version='${tck.range;${mockito.version}}',\
	bnd.identity;id='net.bytebuddy.byte-buddy';version='${tck.range;${byte-buddy.version}}',\
	bnd.identity;id='net.bytebuddy.byte-buddy-agent';version='${tck.range;${byte-buddy.version}}',\
	bnd.identity;id='org.objenesis';version='${tck.range;${objenesis.version}}'

# -runbundles is committed and verified by the build; after a dependency
# change update it with: mvn bnd-resolver:resolve
-runbundles: \
	assertj-core;version='${tck.range;${assertj.version}}',\
	com.fasterxml.woodstox.woodstox-core;version='${tck.range;${woodstox-core.version}}',\
	com.sun.xml.bind.jaxb-core;version='${tck.range;${jaxb-core.version}}',\
	com.sun.xml.bind.jaxb-impl;version='${tck.range;${jaxb-impl.version}}',\
	com.sun.xml.fastinfoset.FastInfoset;version='${tck.range;${FastInfoset.version}}',\
	com.sun.xml.stream.buffer.streambuffer;version='${tck.range;${streambuffer.version}}',\
	com.sun.xml.ws.jaxws-rt;version='${tck.range;${jaxws-rt.version}}',\
	jakarta.activation-api;version='${tck.range;${jakarta.activation-api.version}}',\
	jakarta.annotation-api;version='${tck.range;${jakarta.annotation-api.version}}',\
	jakarta.xml.bind-api;version='${tck.range;${jakarta.xml.bind-api.version}}',\
	jakarta.xml.soap-api;version='${tck.range;${jakarta.xml.soap-api.version}}',\
	jakarta.xml.ws-api;version='${tck.range;${jakarta.xml.ws-api.version}}',\
	junit-jupiter-api;version='${tck.range;${junit-jupiter.version}}',\
	junit-jupiter-engine;version='${tck.range;${junit-jupiter.version}}',\
	junit-jupiter-params;version='${tck.range;${junit-jupiter.version}}',\
	junit-platform-commons;version='${tck.range;${junit-platform.version}}',\
	junit-platform-engine;version='${tck.range;${junit-platform.version}}',\
	junit-platform-launcher;version='${tck.range;${junit-platform.version}}',\
	junit-vintage-engine;version='${tck.range;${junit-jupiter.version}}',\
	net.bytebuddy.byte-buddy;version='${tck.range;${byte-buddy.version}}',\
	net.bytebuddy.byte-buddy-agent;version='${tck.range;${byte-buddy.version}}',\
	org.apache.felix.scr;version='${tck.range;${org.apache.felix.scr.version}}',\
	org.apache.servicemix.bundles.junit;version='${tck.range;${servicemix-junit.version}}',\
	org.awaitility;version='${tck.range;${awaitility.version}}',\
	org.eclipse.osgi-technology.webservices.org.eclipse.osgi.technology.webservices.runtime.registrar;version='${tck.range;${org.eclipse.osgi.technology.webservices.runtime.registrar.version}}',\
	org.glassfish.external.management-api;version='${tck.range;${management-api.version}}',\
	org.glassfish.gmbal.gmbal-api-only;version='${tck.range;${gmbal-api-only.version}}',\
	org.glassfish.ha.ha-api;version='${tck.range;${ha-api.version}}',\
	org.glassfish.hk2.osgi-resource-locator;version='${tck.range;${osgi-resource-locator.version}}',\
	org.hamcrest;version='${tck.range;${hamcrest.version}}',\
	org.jvnet.mimepull;version='${tck.range;${mimepull.version}}',\
	org.jvnet.staxex.stax-ex;version='${tck.range;${stax-ex.version}}',\
	org.mockito.mockito-core;version='${tck.range;${mockito.version}}',\
	org.objenesis;version='${tck.range;${objenesis.version}}',\
	org.opentest4j;version='${tck.range;${opentest4j.version}}',\
	org.osgi.service.component;version='${tck.range;${org.osgi.service.component.version}}',\
	org.osgi.test.assertj.framework;version='${tck.range;${osgi-test.version}}',\
	org.osgi.test.cases.webservice;version='${tck.range;${revision}}',\
	org.osgi.test.common;version='${tck.range;${osgi-test.version}}',\
	org.osgi.test.junit4;version='${tck.range;${osgi-test.version}}',\
	org.osgi.test.junit5;version='${tck.range;${osgi-test.version}}',\
	org.osgi.util.function;version='${tck.range;${org.osgi.util.function.version}}',\
